---
source: core/src/cmd.rs
expression: "strings(&handbrake_args(Path::new(\"in.mkv\"), Path::new(\"out.video.mkv\"),\n&b.resolved.settings, None))"
---
[
  "-i",
  "in.mkv",
  "-o",
  "out.video.mkv",
  "-f",
  "av_mkv",
  "-e",
  "svt_av1_10bit",
  "-q",
  "14",
  "--encoder-preset",
  "5",
  "--encoder-tune",
  "ssim",
  "--hdr-dynamic-metadata",
  "all",
  "--crop-mode",
  "none",
  "--no-comb-detect",
  "--no-decomb",
  "--no-deinterlace",
  "--no-detelecine",
  "-a",
  "none",
  "-s",
  "none",
  "--no-markers",
  "-x",
  "enable-qm=1:qm-min=2:chroma-qm-min=8:qp-scale-compress-strength=1:variance-boost-strength=2:adaptive-film-grain=1:film-grain=4"
]
