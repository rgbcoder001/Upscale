#!/bin/sh
# Refuses a push when a commit or tag in it carries a real email address. The repo is public:
# commits must use the GitHub noreply address (see CLAUDE.md -> Commit identity).
# Enable once per clone: git config core.hooksPath .githooks

allowed='(@users[.]noreply[.]github[.]com|^noreply@github[.]com)$'
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a ref
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes" # new ref: what the remote doesn't have yet
    else
        range="$remote_sha..$local_sha"
    fi
    bad=$(git log --format='%h %ae %ce' $range 2>/dev/null |
        awk -v re="$allowed" '$2 !~ re || $3 !~ re')
    case "$local_ref" in
    refs/tags/*)
        tagger=$(git for-each-ref --format='%(taggeremail:trim)' "$local_ref")
        if [ -n "$tagger" ] && ! printf '%s\n' "$tagger" | grep -Eq "$allowed"; then
            bad="$bad
tag ${local_ref#refs/tags/}: tagger is not a noreply address"
        fi
        ;;
    esac
    if [ -n "$bad" ]; then
        echo "pre-push: refusing to push $local_ref: these use a non-noreply email:" >&2
        printf '%s\n' "$bad" | sed '/^$/d; s/^/  /' >&2
        status=1
    fi
done

if [ $status -ne 0 ]; then
    echo "Set this repo's identity: git config user.email \"<id>+<login>@users.noreply.github.com\"" >&2
    echo "then fix the commits (git commit --amend --reset-author, or a rebase) and push again." >&2
fi
exit $status
