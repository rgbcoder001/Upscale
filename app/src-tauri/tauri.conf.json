{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Upscale",
  "version": "0.7.0",
  "identifier": "com.upscale.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Upscale",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../resources/scripts/*": "scripts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Upscale",
    "shortDescription": "Upscale anime and CG to 4K AV1",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5RkVCNDBBMTdBOUVFQ0MKUldUTTdxa1hDclQrR2VrTFV4YTBvRVJvYWhjU0lXRUE0K0dSNlhlZ1V1d0FBOWpBV25FT3hEYVQK",
      "endpoints": [
        "https://github.com/rgbcoder001/Upscale/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
